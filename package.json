{
  "name": "recouple",
  "private": true,
  "type": "module",
  "description": "Deductions recovery for CPG suppliers: a deterministic, human-gated document workflow.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @recouple/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "./scripts/db-test.sh",
    "verify": "pnpm typecheck && pnpm db:test && pnpm test && pnpm eval",
    "record:cassettes": "tsx scripts/record-cassettes.ts",
    "eval": "tsx scripts/run-evals.ts",
    "render:scans": "tsx scripts/render-scans.mts",
    "build:review": "tsx scripts/build-review-bundle.mts",
    "build:web": "pnpm --filter @recouple/web build",
    "render:web": "./scripts/render-web.sh"
  },
  "devDependencies": {
    "@recouple/adapters": "workspace:*",
    "@recouple/core-domain": "workspace:*",
    "@recouple/decision": "workspace:*",
    "@recouple/evals": "workspace:*",
    "@recouple/extraction": "workspace:*",
    "@recouple/fixtures": "workspace:*",
    "@recouple/ingest": "workspace:*",
    "@recouple/pipeline": "workspace:*",
    "@recouple/store-postgres": "workspace:*",
    "@recouple/web": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^18.0.0",
    "fast-check": "^4.10.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "zod": "^4.6.5"
  }
}