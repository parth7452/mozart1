# `pnpm db:test` and `pnpm test` need exactly two of these: TEST_DATABASE_URL
# and RECOUPLE_TEST_DATABASE. Everything else is here so the shape is known
# before the phase that uses it. Nothing in this file has a default that reaches
# a live vendor.

# --- test database ------------------------------------------------------------
# A throwaway database owned by the connecting role. db:test applies every
# migration to it and the integration tests write rows to its append-only tables
# that can never be removed. These two are the only variables a test run takes
# from this file.
#
# The test-database guard (scripts/test-database.ts) refuses, before anything
# runs, a URL without RECOUPLE_TEST_DATABASE=1, a Supabase host, or a database
# that carries a recouple_app login, a supabase_admin role or applied Supabase
# migrations — and refuses any `pnpm test` whose environment holds DATABASE_URL.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/recouple_test
RECOUPLE_TEST_DATABASE=1

# --- operator / app database --------------------------------------------------
# What the web app (apps/web) and the operator commands (`pnpm link:*`,
# `unlink:qbo`, `sweep:inbound`) connect with: a login that may `set role
# app_rw`, never the owner (docs/supabase.md). No test reads it, nothing in
# `pnpm test` or `pnpm db:test` loads it, and `pnpm test` refuses to start if the
# shell exports it. Left commented out so a copy of this file names no database.
# DATABASE_URL=postgres://recouple_app:…@…pooler.supabase.com:6543/postgres?sslmode=no-verify

# --- Supabase (Phase 1) -------------------------------------------------------
# The schema is deployed to project hvheqbgkvwhlqutklwfh; see docs/supabase.md.
SUPABASE_URL=https://hvheqbgkvwhlqutklwfh.supabase.co
SUPABASE_ANON_KEY=
# Server-side jobs only. Never import this into a request path (invariant 6).
SUPABASE_SERVICE_ROLE_KEY=

# --- malware scanning (Phase 1) -----------------------------------------------
# The scan gate fails closed: no scanner means no verdict, which means the file
# is never read (invariant 4). Set ONE of these pairs.
#
# Deployed — a hosted scan service over HTTPS. clamd has no authentication, so
# it is never exposed directly; see services/clamav-scan and ADR 0018.
# A URL without a token counts as no scanner at all.
CLAMAV_SCAN_URL=
CLAMAV_SCAN_TOKEN=
# Local — clamd over TCP on a network you own. `docker compose up -d clamd`.
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- OCR / layout (Phase 1) ---------------------------------------------------
# Reducto gives scans a text layer so their extracted quotes can be verified,
# and supplies the bounding boxes (ADR 0009). Without it, scans still extract —
# their fields just come back unverifiable.
REDUCTO_API_KEY=

# --- models (Phase 1–2) -------------------------------------------------------
# Extraction, classification, narrative drafting. The reader client is
# constructed with no tools (invariant 4).
ANTHROPIC_API_KEY=

# --- decision layer (Phase 2) -------------------------------------------------
# Jev via TypeSafe. Early access: the provider is isolated behind
# DecisionProvider, and the product ships without it if access is delayed.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- workflow (Phase 1) -------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- email-in (ADR 0047) -----------------------------------------------------
# Vercel **Production only** — never Preview, so Postmark's one webhook URL can
# only ever reach production. Both or neither: one without the other, a secret
# under 64 characters, no Inngest keys or no scanner, and the webhook answers
# 503 and logs why (apps/web/lib/inbound.ts).
#
# Not a signing secret: Postmark signs nothing. It is the password in the
# webhook URL, https://postmark:<secret>@app.mozart.financial/api/inbound/postmark,
# and it reaches every tenant. `openssl rand -hex 32`.
POSTMARK_INBOUND_SECRET=
# A subdomain we use for nothing else, with its MX at inbound.postmarkapp.com.
# Every address is <token>@INBOUND_DOMAIN; the database issues the tokens.
INBOUND_DOMAIN=

# --- operator only: this machine's .env, never Vercel ----------------------------
# `pnpm sweep:inbound` reads Postmark's failed inbound messages with it (ADR 0047
# §12). It reads every tenant's inbound mail and can repoint the webhook, so it
# never goes near the web app. The sweep also needs INBOUND_DOMAIN above.
POSTMARK_SERVER_TOKEN=

# --- QuickBooks Online (Phase 4) ---------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox

# --- billing (Phase 4) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- observability (Phase 1) --------------------------------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Only needed when ANTHROPIC_API_KEY is org-scoped rather than workspace-scoped:
# the API then requires the workspace to bill and rate-limit against.
ANTHROPIC_WORKSPACE_ID=
