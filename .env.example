# Phase 0 needs exactly one of these: DATABASE_URL, for `pnpm db:test`.
# Everything else is here so the shape is known before the phase that uses it.
# Nothing in this file has a default that reaches a live vendor.

# --- database -----------------------------------------------------------------
# A throwaway database owned by the connecting role. db:test applies every
# migration to it; do not point this at anything you care about.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/recouple_test

# --- Supabase (Phase 1) -------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side jobs only. Never import this into a request path (invariant 6).
SUPABASE_SERVICE_ROLE_KEY=

# --- models (Phase 1–2) -------------------------------------------------------
# Extraction, classification, narrative drafting. The reader client is
# constructed with no tools (invariant 4).
ANTHROPIC_API_KEY=
# Scanned / complex-table fallback for remittances.
REDUCTO_API_KEY=

# --- decision layer (Phase 2) -------------------------------------------------
# Jev via TypeSafe. Early access: the provider is isolated behind
# DecisionProvider, and the product ships without it if access is delayed.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- workflow (Phase 1) -------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- email-in (Phase 1) -------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_SECRET=
INBOUND_DOMAIN=in.recouple.app

# --- QuickBooks Online (Phase 4) ---------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox

# --- billing (Phase 4) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- observability (Phase 1) --------------------------------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Only needed when ANTHROPIC_API_KEY is org-scoped rather than workspace-scoped:
# the API then requires the workspace to bill and rate-limit against.
ANTHROPIC_WORKSPACE_ID=
